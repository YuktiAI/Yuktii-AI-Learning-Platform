# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# SQLite (dev): file:./prisma/dev.db
# PostgreSQL (production recommended):
DATABASE_URL="file:./prisma/dev.db"

# ─────────────────────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# ─────────────────────────────────────────────────────────────────────────────
# AI Generation — Free providers only (Phase 8: Claude/Anthropic removed)
# ─────────────────────────────────────────────────────────────────────────────
# Primary: Google Gemini (free tier)
GEMINI_API_KEY=""

# Secondary: Groq (free tier — LPU-accelerated inference)
GROQ_API_KEY=""

# Tertiary: OpenRouter (free-tier models pool)
OPENROUTER_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Payments (Razorpay)
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# IMPORTANT: Production safety gate — must be explicitly "false" in production.
# Leaving this unset or set to "true" bypasses the payment gateway and lets
# students enroll without paying. The app will refuse to start in production
# unless this is set to "false". (See lib/startup-checks.ts)
DISABLE_PAYMENT_GATEWAY="false"

# ─────────────────────────────────────────────────────────────────────────────
# Certificate Storage — AWS S3
# Required in production; omit in dev to fall back to base64 in DB.
# IAM user needs s3:PutObject on the bucket. Bucket should have public-read ACL
# enabled so certificate URLs are permanently accessible without signing.
# ─────────────────────────────────────────────────────────────────────────────
S3_BUCKET=""          # e.g. yuktii-certificates
S3_REGION=""          # e.g. ap-south-1
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Certificate Integrity — HMAC signing (Phase 7)
# Generate with: openssl rand -hex 32
# REQUIRED in production. Without this, certificate IDs are not cryptographically
# signed and can be guessed/forged. The app will warn (not crash) if missing in dev.
# ─────────────────────────────────────────────────────────────────────────────
CERT_HMAC_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Submission Video Storage — Cloudinary (optional)
# Used for storing submission video uploads. S3 is used for certificates.
# ─────────────────────────────────────────────────────────────────────────────
CLOUDINARY_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Email Delivery — Resend (Phase B-2)
# Required for OTP, password reset, and certificate email delivery.
# Create a free API key at https://resend.com
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""      # e.g. re_123456789
RESEND_FROM=""         # e.g. "Yuktii AI Labs" <noreply@yuktiiai.in> (or onboarding@resend.dev in testing)

# ─────────────────────────────────────────────────────────────────────────────
# Background Jobs — Redis + BullMQ
# Required for the AI evaluation worker pipeline.
# Start Redis locally: docker run -p 6379:6379 redis:7-alpine
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────────────────────
# GitHub API (evaluation pipeline — Stage 1 repo verification)
# A personal access token with public_repo read scope.
# Without this, Stage 1 of the evaluation pipeline will fail.
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# App URL (used in certificate verification QR codes, email links)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
