# -------------------------------------------------------------
# Database
# -------------------------------------------------------------
# SQLite (dev): file:./prisma/dev.db
# PostgreSQL (production recommended):
DATABASE_URL="file:./prisma/dev.db"

# -------------------------------------------------------------
# Auth
# -------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# -------------------------------------------------------------
# AI Generation (Groq â€” required for evaluation pipeline)
# -------------------------------------------------------------
GROQ_API_KEY=""

# Anthropic (optional â€” Phase 3 fallback)
ANTHROPIC_API_KEY=""

# -------------------------------------------------------------
# Payments (Razorpay)
# -------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# -------------------------------------------------------------
# Certificate Storage â€” AWS S3
# Required in production; omit in dev to fall back to base64 in DB.
# IAM user needs s3:PutObject on the bucket. Bucket should have public-read ACL
# enabled so certificate URLs are permanently accessible without signing.
# -------------------------------------------------------------
S3_BUCKET=""          # e.g. yuktii-certificates
S3_REGION=""          # e.g. ap-south-1
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# -------------------------------------------------------------
# Submission Video Storage â€” Cloudinary (optional)
# Used for storing submission video uploads. S3 is used for certificates.
# -------------------------------------------------------------
CLOUDINARY_URL=""

# -------------------------------------------------------------
# Email Delivery â€” SMTP
# Required for certificate email delivery. Any SMTP provider works.
# Example: smtp.gmail.com:587 with app password (not account password).
# Missing SMTP config is logged to EmailLog as a "failed" send â€” visible
# in the admin portal Email Logs page for retry/investigation.
# -------------------------------------------------------------
SMTP_HOST=""          # e.g. smtp.gmail.com
SMTP_PORT="587"
SMTP_USER=""          # e.g. noreply@yuktii.com
SMTP_PASS=""          # App password (Gmail: 16-char app password)
SMTP_FROM=""          # e.g. "Yuktii AI Labs" <noreply@yuktii.com>

# -------------------------------------------------------------
# Background Jobs â€” Redis + BullMQ
# Required for the AI evaluation worker pipeline.
# Start Redis locally: docker run -p 6379:6379 redis:7-alpine
# -------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -------------------------------------------------------------
# GitHub API (evaluation pipeline â€” Stage 1 repo verification)
# A personal access token with public_repo read scope.
# Without this, Stage 1 of the evaluation pipeline will fail.
# -------------------------------------------------------------
GITHUB_TOKEN=""

# -------------------------------------------------------------
# App URL (used in certificate verification QR codes, email links)
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
